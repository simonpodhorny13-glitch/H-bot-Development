TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: channel ID for moderation logs.
# If empty, H bot Development looks for a text channel named mod-logs.
MOD_LOG_CHANNEL_ID=

# AutoMod strikes expire after this many minutes.
AUTOMOD_STRIKE_TTL_MINUTES=30

# Optional join-burst raid detection.
# If true, also enable Server Members Intent in the Discord Developer Portal.
ENABLE_JOIN_RAID_DETECTION=false
